# PlanStar 客户端连接后端 agent_harness_server 的运行时配置。
# 由 flutter_dotenv 在启动时读取（已在 pubspec 的 assets 里注册为 `.env` 资源）。
#
# 后端 better-auth 挂载路径：Hono basePath=/api + auth 路由 /auth/*，
# 因此 BetterAuth 客户端 base = http://localhost:8000/api/auth
# （与 front_web/.env 的 VITE_API_BASE_URL=http://localhost:8000/api 同源）。
BETTER_AUTH_URL=http://localhost:8000/api/auth

# Google 登录（google_sign_in）用的 OAuth client id。
# 这些是公开标识符，不是密钥；OAuth client secret 只留在后端（BETTER_AUTH_SECRET）。
# 在 Google Cloud Console 创建；本地未配置时留空即可，
# GoogleAuthService.init 会捕获异常并跳过 Google 登录（其余 BetterAuth 流程不受影响）。
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
