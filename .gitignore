# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
# Package-local build caches (e.g. plan_editor's dart build test cache)
build/
/coverage/

# Local tool state and generated source dumps
.workbuddy/
dart_sources.md
repomix-output.*
# ZCode agent local plan/session state and its own ignore file.
.zcode/
.zcodeignore
# DevTools extension panel state (auto-written by `flutter run`); per-machine.
devtools_options.yaml

# Local archive of third-party reference sources (~88 MB, untracked by intent).
# Not a pubspec dependency and no code imports it; keeping it out of the repo
# avoids a one-way 88 MB commit. Do not `git add -A` at the repository root.
/_archive_project/

# Local clones of third-party reference repositories (appflowy-editor etc.),
# intentionally untracked for source reading only; same policy as _archive_project.
/_archive_docs/

/_archive/
/packages/_archive/

# Vendored third-party UI reference clone, intentionally untracked.
# It is not a pubspec dependency and no code imports it; keep provenance and
# pinned version in the ADR instead of 5.7 MB of upstream history.
# See docs/adr/ADR-0001-dep-vendored-shadcn-ui.md before deleting or re-adding.
/packages/flutter-shadcn-ui/
